# --- Aplicación ---
APP_ENV=development            # development | production (afecta modo gin y formato de logs)
PORT=8080

# --- Autenticación ---
SECRET_SIGNING_KEY=esta_es_una_clave_super_duper_secreta_para_firmar_tokens_de_acceso_asi_que_no_te_pases_de_vivo
ACCESS_TOKEN_TTL=15m           # duración del access token (opcional, default 15m)
REFRESH_TOKEN_TTL=168h         # duración del refresh token (opcional, default 7d)
BCRYPT_COST=10                 # costo de hashing de contraseñas (opcional, default 10)

# --- Base de datos (PostgreSQL) ---
# IMPORTANTE (Fase 5, Row-Level Security): en producción conectá con un rol
# NO superusuario (ej. deckbuilder_app con LOGIN). RLS es lo que aísla los
# mazos privados y de organización en la BD; un superusuario la IGNORA.
# El rol debe ser dueño de las tablas (o tener SELECT/INSERT/UPDATE/DELETE);
# la migración aplica FORCE ROW LEVEL SECURITY para que aplique al dueño.
DATABASE_URL=postgres://deckbuilder_app:pass@localhost:5432/deckbuilder?sslmode=disable
DB_MAX_OPEN_CONNS=10           # pool: conexiones máximas (opcional, default 10)
DB_MAX_IDLE_CONNS=5            # pool: conexiones idle (opcional, default 5)
DB_CONN_MAX_LIFETIME=30m       # pool: vida máxima de una conexión (opcional, default 30m)

# --- Endurecimiento (Fase 6) ---
# Rate limiting por IP (token bucket en memoria; dos clases):
#   general = toda la API; auth = /api/v3/auth/* (más estricto, anti fuerza bruta).
# Rutas exentas: /healthz, /readyz, /metrics, /openapi.yaml y preflights OPTIONS.
RATE_LIMIT_RPS=20              # tasa general (opcional, default 20)
RATE_LIMIT_BURST=40            # ráfaga general (opcional, default 40)
RATE_LIMIT_AUTH_RPS=5          # tasa en /auth/* (opcional, default 5)
RATE_LIMIT_AUTH_BURST=10       # ráfaga en /auth/* (opcional, default 10)

# CORS: orígenes permitidos para el navegador, separados por coma.
# Vacío (default) = sin CORS (same-origin). Nunca combines "*" con cookies
# (esta API usa Bearer tokens, no cookies).
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com,https://admin.ejemplo.com
CORS_ALLOWED_ORIGINS=

# --- Docker (docker-compose up --build) ---
# El compose crea el rol no-superusuario deckbuilder (dueño de la BD) vía
# deploy/postgres-init.sql, así que RLS aplica igual que en producción.
# POSTGRES_PASSWORD solo protege el puerto expuesto de la DB en local.

# --- Tests de integración (solo desarrollo/CI) ---
# TEST_DATABASE_URL=postgres://user:pass@localhost:5432/deckbuilder_test?sslmode=disable
