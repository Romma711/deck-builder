# Copiar a .env y completar. NUNCA versionar el .env real.

# --- Dominio ---
# Producción: el dominio real (su DNS debe apuntar al servidor).
# Prueba local: deckbuilder.localhost (Caddy usa una CA local).
DOMAIN=deckbuilder.localhost
# URL pública completa (canonical y sitemap). Incluye el puerto si no es 443.
SITE_URL=https://deckbuilder.localhost:8443

# Puertos del host. Producción: 80 y 443. Local: otros, si esos están ocupados.
HTTP_PORT=8088
HTTPS_PORT=8443

# --- Secretos (generalos con: openssl rand -base64 48) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SECRET_SIGNING_KEY=

# --- Opcional ---
# Ruta al repo del front, relativa a esta carpeta.
# WEB_CONTEXT=../../deck-builder-front
# Subred de la red edge (cambiala si choca con otra red del servidor);
# CADDY_IP y WEB_IP deben quedar dentro de ella.
# EDGE_SUBNET=172.30.0.0/24
# CADDY_IP=172.30.0.10
# WEB_IP=172.30.0.11
